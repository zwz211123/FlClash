#!/system/bin/sh
MODDIR="${0%/*}/.."
DATA_DIR=/data/adb/flclash-root
PID_FILE="$DATA_DIR/core.pid"
LOG_FILE="$DATA_DIR/core.log"
CORE="$MODDIR/bin/flclash-core"
CONFIG_PATH_FILE="$DATA_DIR/config-path"

configured_path() {
  [ -f "$CONFIG_PATH_FILE" ] || { echo 'No app config path configured' >&2; return 1; }
  IFS= read -r config_path < "$CONFIG_PATH_FILE"
  case "$config_path" in
    /data/user/[0-9]*/com.follow.clash/files/config.yaml|/data/user/[0-9]*/com.follow.clash.dev/files/config.yaml|/data/data/com.follow.clash/files/config.yaml|/data/data/com.follow.clash.dev/files/config.yaml) ;;
    *) echo 'Invalid app config path' >&2; return 1 ;;
  esac
  [ -f "${config_path%/*}/root-control-token" ] || { echo 'App control token is missing' >&2; return 1; }
}

running_pid() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE")"
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\000' ' ' < "/proc/$pid/cmdline" | grep -Fq "$CORE" || return 1
  printf '%s\n' "$pid"
}

case "$1" in
  start)
    [ -x "$CORE" ] || { echo 'Missing executable core' >&2; exit 1; }
    configured_path || exit 1
    if running_pid >/dev/null; then exit 0; fi
    home_dir="${config_path%/*}"
    if [ -f "$DATA_DIR/autostart" ]; then
      "$CORE" --root-listen "$home_dir" autostart >>"$LOG_FILE" 2>&1 &
    else
      "$CORE" --root-listen "$home_dir" >>"$LOG_FILE" 2>&1 &
    fi
    pid=$!
    echo "$pid" > "$PID_FILE"
    sleep 2
    if ! running_pid >/dev/null; then
      rm -f "$PID_FILE"
      echo 'Core exited; inspect core.log' >&2
      exit 1
    fi
    ;;
  stop)
    pid="$(running_pid)" || exit 0
    kill -TERM "$pid" || exit 1
    count=0
    while running_pid >/dev/null && [ "$count" -lt 10 ]; do
      sleep 1
      count=$((count + 1))
    done
    if running_pid >/dev/null; then
      echo 'Core did not stop; leaving PID file intact' >&2
      exit 1
    fi
    rm -f "$PID_FILE"
    ;;
  restart) "$0" stop && "$0" start ;;
  configure)
    config_path="$2"
    case "$config_path" in
      /data/user/[0-9]*/com.follow.clash/files/config.yaml|/data/user/[0-9]*/com.follow.clash.dev/files/config.yaml|/data/data/com.follow.clash/files/config.yaml|/data/data/com.follow.clash.dev/files/config.yaml) ;;
      *) echo 'Expected the FlClash app config.yaml path' >&2; exit 2 ;;
    esac
    if [ -f "$CONFIG_PATH_FILE" ]; then
      IFS= read -r old_config_path < "$CONFIG_PATH_FILE"
      if [ "$old_config_path" != "$config_path" ]; then
        "$0" stop || exit 1
      fi
    fi
    mkdir -p "$DATA_DIR" || exit 1
    chmod 700 "$DATA_DIR"
    printf '%s\n' "$config_path" > "$CONFIG_PATH_FILE" || exit 1
    chmod 600 "$CONFIG_PATH_FILE"
    ;;
  enable) touch "$DATA_DIR/autostart" ;;
  disable) rm -f "$DATA_DIR/autostart" ;;
  status) if running_pid; then exit 0; else echo stopped; exit 1; fi ;;
  enabled) [ -f "$DATA_DIR/autostart" ] ;;
  test) configured_path && [ -f "$config_path" ] && "$CORE" --root-test "$config_path" ;;
  *) echo 'Usage: flclash-root {configure <app config.yaml>|start|stop|restart|enable|disable|status|test}' >&2; exit 2 ;;
esac
